{
  "name": "duckstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint . --deny-warnings",
    "lint:strict": "oxlint --deny-warnings src/revisioned-workspace/schemas.ts src/revisioned-workspace/envelope.ts src/agent-control-plane/envelope.ts src/agent-control-plane/registration.ts src/revisioned-workspace/projection.ts src/dataset-custody/schemas.ts src/dataset-custody/sql-inspector.ts src/dataset-custody/kernel.ts src/dataset-custody/egress.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "duckdb:download": "bash scripts/download-duckdb-wasm.sh",
    "build": "bash -c '[ -f public/duckdb/duckdb-eh.wasm ] || { echo \"ERROR: public/duckdb/ runtime assets are missing — run: pnpm duckdb:download\" >&2; exit 1; }' && vite build && bash scripts/gzip-wasm.sh",
    "docs:parity": "bash scripts/doc-parity-check.sh",
    "e2e": "playwright test",
    "e2e:changed": "playwright test --only-changed",
    "verify:webmcp": "node scripts/verify-webmcp-surface.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "@tanstack/zod-adapter": "1.167.0",
    "echarts": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-grab": "0.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
